# Copie para secrets.properties (ignorado pelo Git) e preencha. Nunca faça commit do arquivo real.
# No CI, defina os mesmos nomes como GitHub Secrets / variáveis de ambiente.

# Google Maps Platform: Maps SDK for Android, Routes API e Places API (New).
# Restrinja a chave ao pacote com.routeprice.app(.debug) + SHA-1 da assinatura e a essas três APIs.
MAPS_API_KEY=

# Opcional: keystore de debug compartilhada (assinatura estável entre máquinas e CI).
DEBUG_KEYSTORE_PATH=
DEBUG_KEYSTORE_PASSWORD=
DEBUG_KEY_ALIAS=
DEBUG_KEY_PASSWORD=

# Release assinada (guarde a keystore fora do repositório).
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
