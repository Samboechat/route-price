<?xml version="1.0" encoding="utf-8"?>
<!-- Somente HTTPS; nenhum certificado de usuário é confiável em produção. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
